{
  "name": "pr-review",
  "productName": "PR Review",
  "version": "0.3.0",
  "description": "A macOS app for reviewing GitHub pull requests in your own checkout: each PR in a git worktree, comments that follow the code, drafts that stay local until you submit.",
  "license": "MIT",
  "homepage": "https://github.com/stefan-schweiger/pr-review",
  "repository": {
    "type": "git",
    "url": "https://github.com/stefan-schweiger/pr-review.git"
  },
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "e2e": "electron-vite build && playwright test",
    "eval": "tsx scripts/eval-anchoring.ts",
    "dist": "electron-vite build && electron-builder --mac --arm64 --publish never",
    "release": "node scripts/release.mjs",
    "release:publish": "node scripts/release.mjs --publish"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.322",
    "@anthropic-ai/sdk": "1.8.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@pierre/diffs": "1.7.1",
    "dompurify": "3.5.0",
    "marked": "16.4.2",
    "mermaid": "12.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.24.1",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "material-icon-theme": "5.40.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller": false
  }
}
