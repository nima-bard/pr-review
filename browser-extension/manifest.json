{
  "manifest_version": 3,
  "name": "Open in PR Review",
  "version": "1.0.0",
  "description": "Opens GitHub pull requests in the PR Review app instead of on github.com.",
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" },
  "permissions": ["storage", "activeTab"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["https://github.com/*"], "js": ["content.js"], "run_at": "document_start" }],
  "web_accessible_resources": [{ "resources": ["icon32.png"], "matches": ["https://github.com/*"] }],
  "action": { "default_title": "Open in PR Review", "default_popup": "popup.html", "default_icon": { "16": "icon16.png", "32": "icon32.png" } }
}
